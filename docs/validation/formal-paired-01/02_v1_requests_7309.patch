+from requests.utils import _parse_content_type_header
+import sys
+import os
+
+print(f"Python path: {sys.path}")
+print(f"Executing from: {os.getcwd()}")
+
+def test_malformed_content_type():
+
+    header = "text/html; charset=utf-8; malformed"
+    content_type, params = _parse_content_type_header(header)
+    print(f"Header: {header}")
+    print(f"Content-Type: {content_type}")
+    print(f"Params: {params}")
+    
+    assert "malformed" not in params, f"Expected 'malformed' to be ignored, but got {params}"
+    assert params == {"charset": "utf-8"}
+
+if __name__ == "__main__":
+    try:
+        test_malformed_content_type()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
