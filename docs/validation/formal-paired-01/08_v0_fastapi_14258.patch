diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..1e5a177a
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,27 @@
+from fastapi import FastAPI, APIRouter
+from fastapi.exceptions import FastAPIError
+import pytest
+
+def test_router_include_self():
+    router = APIRouter()
+    try:
+        router.include_router(router)
+        print("Successfully included router into itself (unexpected)")
+    except FastAPIError as e:
+        print(f"Caught expected error: {e}")
+    except Exception as e:
+        print(f"Caught unexpected error: {type(e).__name__}: {e}")
+
+def test_app_include_self():
+    app = FastAPI()
+    try:
+        app.include_router(app) # type: ignore
+        print("Successfully included app into itself (unexpected)")
+    except FastAPIError as e:
+        print(f"Caught expected error: {e}")
+    except Exception as e:
+        print(f"Caught unexpected error: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_router_include_self()
+    test_app_include_self()
diff --git a/reproduce_issue_runtime.py b/reproduce_issue_runtime.py
new file mode 100644
index 00000000..ff247f18
--- /dev/null
+++ b/reproduce_issue_runtime.py
@@ -0,0 +1,24 @@
+from fastapi import APIRouter, FastAPI
+from fastapi.testclient import TestClient
+
+def test_include_router_self_runtime():
+    app = FastAPI()
+    router = APIRouter()
+    
+    @router.get("/test")
+    def read_test():
+        return {"hello": "world"}
+        
+    router.include_router(router)
+    app.include_router(router)
+    
+    client = TestClient(app)
+    print("Making request to /test...")
+    try:
+        response = client.get("/test")
+        print(f"Response: {response.json()}")
+    except Exception as e:
+        print(f"Caught exception during request: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_include_router_self_runtime()
