diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..00c5c44
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,19 @@
+import xarray as xr
+import numpy as np
+
+ds = xr.Dataset({"a": (("x",), [1, 2, 3]), "b": (("x",), [4, 5, 6])})
+print("Original ds:\n", ds)
+
+try:
+    zeros = xr.zeros_like(ds, dtype=float)
+    print("\nzeros_like with dtype=float:\n", zeros)
+    print("\nzeros dtype:\n", zeros.dtypes)
+except Exception as e:
+    print("\nError calling zeros_like: ", e)
+
+try:
+    ones = xr.ones_like(ds, dtype=float)
+    print("\nones_like with dtype=float:\n", ones)
+    print("\nones dtype:\n", ones.dtypes)
+except Exception as e:
+    print("\nError calling ones_like: ", e)
