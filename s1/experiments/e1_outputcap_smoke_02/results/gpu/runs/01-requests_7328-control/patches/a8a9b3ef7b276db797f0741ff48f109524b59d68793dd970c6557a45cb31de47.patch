@@ -0,0 +1,73 @@
+
+import requests
+from requests import Session, Response
+from requests.models import PreparedRequest
+from unittest.mock import MagicMock
+
+def test_redirect_history_self_reference():
+    session = Session()
+    adapter = MagicMock()
+    session.get_adapter = MagicMock(return_value=adapter)
+
+    # Mock responses for 2 redirects
+    # resp0 -> 301 -> resp1 -> 301 -> resp2 -> 200
+    resp0 = Response()
+    resp0.status_code = 301
+    resp0.url = "http://example.com/0"
+    resp0.raw = MagicMock()
+
+    resp1 = Response()
+    resp1.status_code = 301
+    resp1.url = "http://example.com/1"
+    resp1.raw = MagicMock()
+
+    resp2 = Response()
+    resp2.status_code = 200
+    resp2.url = "http://example.com/2"
+    resp2.raw = MagicMock()
+
+    # Mock get_redirect_target to return the next URL
+    session.get_redirect_target = MagicMock(side_effect=[
+        "http://example.com/1",
+        "http://example.com/2",
+        None
+    ])
+
+    # Mock adapter.send to return the responses in order
+    adapter.send.side_effect = [resp0, resp1, resp2]
+
+    req = PreparedRequest()
+    req.url = "http://example.com/0"
+    req.method = "GET"
+
+    response = session.send(req, allow_redirects=True)
+
+    print(f"Final response URL: {response.url}")
+    print(f"History length: {len(response.history)}")
+
+    # Check if any response in the history chain contains itself in its history
+    all_responses = [response] + list(response.history)
+    found_self_reference = False
+    for r in all_responses:
+        for h in getattr(r, 'history', []):
+            if h is r:
+                print(f"Self-reference found in {r.url}")
+                found_self_reference = True
+
+    if not found_self_reference:
+        print("No self-reference found.")
+
+    assert not found_self_reference, "Self-reference should not be present in response history"
+
+if __name__ == "__main__":
+    try:
+        test_redirect_history_self_reference()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
