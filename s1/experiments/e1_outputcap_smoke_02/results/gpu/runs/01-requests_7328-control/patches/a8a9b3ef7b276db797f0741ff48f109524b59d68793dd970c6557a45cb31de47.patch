@@ -0,0 +1,66 @@
+import requests
+from requests.models import PreparedRequest, Response
+from requests.utils import CaseInsensitiveDict
+import gc
+
+def reproduce():
+    # Setup a mock-like environment
+    # We need a PreparedRequest and a Response
+    req = PreparedRequest()
+    req.headers = CaseInsensitiveDict()
+    req.url = "http://example.com"
+    req.method = "GET"
+
+    # Create a response that looks like it came from a redirect
+    resp = Response()
+    resp.url = "http://example.com/redirect"
+    resp.status_code = 302
+    # Mock the request that created this response
+    resp.request = req
+
+    # Simulate the loop in resolve_redirects
+    hist = []
+    
+    # First redirect
+    # In resolve_redirects:
+    # hist.append(resp)
+    # resp.history = hist[1:]
+    hist.append(resp)
+    resp.history = hist[1:]
+    
+    print(f"After 1st redirect, resp.history: {resp.history}")
+    # hist is [resp], hist[1:] is []
+    # resp.history is [] - No self-reference yet.
+
+    # Create a second response for the second redirect
+    resp2 = Response()
+    resp2.url = "http://example.com/redirect2"
+    resp2.status_code = 302
+    resp2.request = req
+    
+    # Second redirect
+    # In resolve_redirects:
+    # hist.append(resp2)
+    # resp2.history = hist[1:]
+    hist.append(resp2)
+    resp2.history = hist[1:]
+    
+    print(f"After 2nd redirect, resp2.history: {resp2.history}")
+    # hist is [resp, resp2], hist[1:] is [resp2]
+    # resp2.history is [resp2] - SELF REFERENCE!
+
+    # Verify self-reference
+    if resp2 in resp2.history:
+        print("SUCCESS: Self-reference detected in resp2.history")
+    else:
+        print("FAILURE: No self-reference detected")
+
+    # Check if this prevents GC
+    # Create a cycle: resp2 -> resp2.history -> [resp2]
+    # We want to see if the objects are collected.
+    # Since it's a simple cycle, GC should eventually handle it,
+    # but the issue is "reference explosion delaying the objects being properly cleaned up".
+    # A direct reference can keep it alive longer than expected if there are other references.
+
+if __name__ == "__main__":
+    reproduce()
