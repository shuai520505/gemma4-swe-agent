index 00000000..9be2b990
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,12 @@
+from rich.text import Text
+
+t = Text("hello")
+try:
+    t.append_tokens([(None, "red")])
+except Exception as e:
+    print(f"Caught exception: {type(e).__name__}: {e}")
+
+try:
+    print(t.plain)
+except Exception as e:
+    print(f"Caught exception during plain access: {type(e).__name__}: {e}")
